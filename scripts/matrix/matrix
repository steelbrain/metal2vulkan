# --- running jobs --------------------------------------------------------------------------------

def layer_carry(path):
    """The validation layer's carry at PATH, a git repository (scripts/validation-layer): its
    (--carry value, mirror variable, commit), or None where there is none."""
    if not (path / ".git").is_dir():
        return None
    rev = git("rev-parse", "HEAD", cwd=path)
    return f"{path}@{rev}", "POTLUCK_MIRROR_" + re.sub(r"[^A-Za-z0-9_]", "_", path.name), rev


class Run:
    def __init__(self, sha, cfg, nodes, legs, build_node, rdir):
        self.sha, self.short, self.cfg, self.nodes = sha, sha[:12], cfg, nodes
        self.legs, self.build_node, self.rdir = legs, build_node, rdir
        self.stats = load(STATE / "stats.json", {})
        self.spaces = load(STATE / "workspaces.json", {})
        self.lock = threading.Lock()
        self.jobs, self.carries, self.failures = [], [], {}
        #: Each Linux GPU node's carry, (--carry value, mirror variable, commit), once its legs
        #: started: a leg's harness timed once more for a cross-GPU outlier (retime) takes it.
        self.carried = {}
        self.build_info = None
        #: Whether the commit has the harness, whose timed workloads each GPU leg runs.
        #: Whether the commit has the lock budget, which a node naming its event must measure.
        self.lock_budget = subprocess.run(["git", "cat-file", "-e", f"{sha}:crates/metal2vulkan-rt/src/tests/locks.rs"],
                                          cwd=REPO, capture_output=True).returncode == 0
        self.harness = subprocess.run(["git", "cat-file", "-e", f"{sha}:crates/metal2vulkan-harness/Cargo.toml"],
                                      cwd=REPO, capture_output=True).returncode == 0
        #: The validation layer's carry: (--carry value, mirror variable, commit), or None.
        self.layer = layer_carry(Path(cfg.get("validation_layer", LAYER)).expanduser())
        #: The messages of the commits since the golden table's last bless, which
        #: results.old_path_moved reads for the one phrase that lets the old path move.
        blessed = git("log", "-1", "--format=%H", sha, "--", GOLDEN_TABLE)
        self.since_bless = [m for m in git("log", "--format=%B%x00", f"{blessed}..{sha}").split("\0")
                            if m.strip()]

    def setup(self, node):
        return self.cfg.get("setup", {}).get(node, "")

    def size(self, kind, node):
        """RAM and timeout from this kind's last measured runs on NODE. RAM: 1.3x the largest
        peak of the last three that started in a fresh workspace (a run that peaked at its
        reservation keeps it; one that ended for want of RAM gets 2x), else the kind's default. For
        a kind that keeps a workspace that is a whole build: an incremental build's peak says
        nothing of one, and a kept workspace can rebuild most of the tree; every run of a kind that
        keeps none starts fresh. Minutes: 1.5x the longest of the last three, never below the
        kind's default: an incremental run's minutes say nothing of a full rebuild's."""
        ram, minutes = DEFAULTS[kind]
        runs = self.stats.get(f"{kind}@{node}", [])
        whole = [r for r in runs if r.get("full")][-3:]
        if whole:
            ram = max(2 * r["ram"] if r["killed"] else
                      r["ram"] if r["peak"] >= 0.95 * r["ram"] else math.ceil(r["peak"] * 1.3 + 0.5)
                      for r in whole)
        if runs:
            minutes = max(minutes, math.ceil(1.5 * max(r["minutes"] for r in runs[-3:])))
        return max(ram, 2), minutes

    def job(self, kind, node, script, name, gpus=(), carries=(), space=None, exclusive=False, room=None):
        """Dispatch SCRIPT on NODE, wait for it, and return (exit code, output, job record).
        SPACE names a workspace kept for this kind on this node across runs (incremental builds,
        and no fresh checkout of the tree). A job that times anything is EXCLUSIVE. It is sized as
        a whole build (size). A job that ended for want of RAM runs again with twice its room, up
        to the kind's default (ROOM, the room of that run again): the leg is not the job's to
        lose. Wanting RAM is a peak at the reservation and either a kill over it or a failed
        allocation in the output: a driver that pins host memory for a device allocation can
        answer the job's limit with an out-of-memory error rather than the kill."""
        key = f"{space}@{node}" if space else None
        with self.lock:
            ws = self.spaces.get(key) if key else None
        ram, minutes = self.size(kind, node)
        if room:
            ram = room
        args = ["dispatch", "--json", "--priority", "5", "--kill-on-stall", "--label", "agent=matrix",
                "--label", f"matrix={self.short}", "--on", f"node={node}", "--ram", str(ram),
                "--timeout", f"{minutes}m"]
        if self.nodes[node]["os"] == "windows":
            args += ["--on", "os=windows"]
        for gpu in gpus:
            args += ["--gpu", gpu]
        for carry in carries:
            args += ["--carry", carry]
        if exclusive:
            args += ["--exclusive"]
        if key:
            args += ["--hold", "24h"]
        # The script travels in the job's environment, never on its command line: Windows starts a
        # job's command through a command line cut at 8,191 characters, and the harness legs'
        # scripts are longer (their per-row limits), so bash read a truncated script there.
        args += ["--env", f"M2V_JOB={script}"]
        cmd = ["--", "bash", "-c", 's=$M2V_JOB; unset M2V_JOB; eval "$s"']
        r = potluck(*args, *(["--workspace", ws, "--advance"] if ws else []), *cmd)
        if ws and "job" not in dispatched(r):
            log(f"{name}: workspace {ws} refused ({dispatched(r).get('error', '')[:200]}); a fresh one")
            potluck("release", ws)
            with self.lock:
                self.spaces.pop(key, None)
            ws = None
            r = potluck(*args, *cmd)
        reply = dispatched(r)
        if "job" not in reply:
            return None, f"dispatch failed: {reply.get('error', '')[:500]}", None
        jid = reply["job"]
        log(f"{name}: job {jid} on {node} ({ram} GiB, {minutes} min)")
        with self.lock:
            self.jobs.append(jid)
        w = subprocess.run(["potluck", "wait", jid], cwd=TREE, capture_output=True, text=True, errors="replace")
        out = w.stdout + w.stderr
        (self.rdir / f"{name}.log").write_text(out)
        rec = self.record(jid)
        killed = False
        if rec and rec.get("started_at") and rec.get("ended_at"):
            peak = rec.get("usage", {}).get("peak_mem_bytes", 0) / 2**30
            took = (rec.get("ended_at", 0) - rec.get("started_at", 0)) / 60000
            code = rec.get("exit_code")
            killed = peak >= 0.95 * ram and (code == 137 or (code != 0 and bool(STARVED.search(out))))
            with self.lock:
                self.stats.setdefault(f"{kind}@{node}", []).append(
                    dict(ram=ram, peak=round(peak, 2), minutes=round(took, 2), killed=killed,
                         full=ws is None))
                self.stats[f"{kind}@{node}"] = self.stats[f"{kind}@{node}"][-6:]
                if key and rec.get("workspace"):
                    self.spaces[key] = rec["workspace"]
        log(f"{name}: job {jid} ended {w.returncode}")
        cap = max(DEFAULTS[kind][0], ram)
        if killed and ram < cap:
            log(f"{name}: wanted more than its {ram} GiB; again with {min(2 * ram, cap)} GiB")
            return self.job(kind, node, script, name, gpus, carries, space, exclusive,
                            room=min(2 * ram, cap))
        return w.returncode, out, rec

    def record(self, jid):
        r = potluck("status", "--json")
        try:
            status = json.loads(r.stdout)
        except ValueError:
            return None
        for kind in ("recent", "running"):
            for j in status.get(kind, []):
                if j.get("id") == jid:
                    return j
        return None

    def carry(self, node, rec):
        """Copy a finished build's files out of its workspace into a git repository of its own,
        which GPU jobs name with --carry. Returns (--carry value, mirror variable, commit)."""
        name = f"m2v-matrix-{self.short}-{re.sub(r'[^A-Za-z0-9]', '', node)[-12:]}"
        cdir = STATE / "carry" / name
        shutil.rmtree(cdir, ignore_errors=True)
        cdir.mkdir(parents=True)
        git("init", "-q", cwd=cdir)
        files = [ARCHIVE] + ([HARNESS] if self.harness else [])
        for file in files:
            if potluck("cp", f"{rec['workspace']}:{file}", str(cdir / file)).returncode:
                return None
        git("add", *files, cwd=cdir)
        git("-c", "user.name=matrix", "-c", "user.email=matrix@localhost", "commit", "-q", "-m", self.sha, cwd=cdir)
        for file in files:
            (cdir / file).unlink()
        with self.lock:
            self.carries.append(name)
        rev = git("rev-parse", "HEAD", cwd=cdir)
        return f"{cdir}@{rev}", "POTLUCK_MIRROR_" + re.sub(r"[^A-Za-z0-9_]", "_", name), rev

    def fail(self, legs, why, rec=None):
        with self.lock:
            for leg in legs:
                self.failures.setdefault(leg.id, []).append(why)
                if rec:
                    leg.jobs.append(rec.get("id"))

    def linux_build(self, node, label):
        """Build the GPU legs' archive on NODE (no GPU held) and carry it: (carry, mirror, rev)."""
        code, out, rec = self.job("build", node, build_script(self.short, self.setup(node), self.harness), label,
                                  space="build")
        if code != 0 or not rec:
            return None, f"the build ({label}, job {rec and rec.get('id')}) failed: exit {code}"
        if node == self.build_node["node"]:
            self.build_info = dict(node=node, job=rec["id"])
        made = self.carry(node, rec)
        return made, None if made else f"the archive of job {rec['id']} could not be copied"

    def gpu_node(self, node, legs, ready):
        """One node's GPU legs: their device tests in turn, in one job holding their GPUs, then
        each leg's harness in a job of its own that holds the node alone and times that one GPU.
        READY gives the carry."""
        made, why = ready()
        if not made:
            return self.fail(legs, why)
        carry, mirror, rev = made
        with self.lock:
            self.carried[node] = made
        for leg in legs:
            leg.started = time.time()
        jobs = [("rt", legs, f"rt-{node}")] + ([("harness", [leg], f"harness-{leg.id}") for leg in legs]
                                               if self.harness else [])
        while jobs:
            suite, these, name = jobs.pop(0)
            layer = self.layer if suite == "rt" else None
            script = gpu_script(self.short, self.setup(node), these, mirror, rev, suite, not jobs,
                                layer and layer[1:], self.nodes.get(node, {}).get("cpu_model"))
            code, out, rec = self.job("gpu" if suite == "rt" else "time", node, script, name,
                                      gpus=[leg.gpu for leg in these],
                                      carries=[carry] + ([layer[0]] if layer else []), space="gpu",
                                      exclusive=suite == "harness")
            self.finish(these, code, out, rec, suite)
            if suite == "harness" and self.timed_again(these[0]):
                jobs.append((suite, these, f"{name}-again"))

    def timed_again(self, leg):
        """Whether LEG's harness, just timed, is timed once more, after the node's other jobs: the
        old runtime's own spread across its passes (results.base_spread) is past
        results.BASE_SPREAD in its first timing. Each timing's spread is kept in LEG.timings."""
        spread = results.base_spread(results.leg_records(leg.parsed)[0]["time"],
                                     self.nodes.get(leg.node, {}).get("cpu_model"))
        leg.timings.append(spread)
        again = len(leg.timings) == 1 and spread is not None and spread[0] > results.BASE_SPREAD
        if again:
            log(f"{leg.id}: the old runtime's own spread {spread[0]:.1%} on {spread[1]} voids its times; "
                "timed once more, later")
        return again

    def retime(self, legs):
        """Each of LEGS's harness timed once more, after every leg is in: a leg whose one pass has
        a harness row's cross-GPU outlier (results.outliers_to_retime), which then fails it only
        where both passes agree (results.time_outliers). The second pass's records take the
        first's, as a timing's do in timed_again. A node's legs in turn, the nodes at once, each
        job holding its node alone as a timing does; a Linux node's job lays the tree out again
        and its last one tidies, as the node's last job had."""
        by_node = {}
        for leg in legs:
            by_node.setdefault(leg.node, []).append(leg)

        def chain(node, these):
            for leg in these:
                try:
                    if self.nodes[node]["os"] == "windows":
                        code, out, rec = self.job("wintime", node, winrun_script(leg, "harness"),
                                                  f"winharness-{leg.id}-outlier", gpus=[leg.gpu], space="win",
                                                  exclusive=True)
                    elif node in self.carried:
                        carry, mirror, rev = self.carried[node]
                        script = gpu_script(self.short, self.setup(node), [leg], mirror, rev, "harness",
                                            leg is these[-1], None, self.nodes.get(node, {}).get("cpu_model"))
                        code, out, rec = self.job("time", node, script, f"harness-{leg.id}-outlier",
                                                  gpus=[leg.gpu], carries=[carry], space="gpu", exclusive=True)
                    else:
                        self.fail([leg], f"its cross-GPU outlier's re-time found no carry on {node}")
                        continue
                    self.finish([leg], code, out, rec, "harness")
                except Exception as error:  # a re-time's own failure fails its leg, not the run
                    log(f"retime {leg.id}: {error!r}")
                    self.fail([leg], f"its cross-GPU outlier's re-time failed: {error!r}")

        threads = [threading.Thread(target=chain, args=(node, these)) for node, these in sorted(by_node.items())]
        for t in threads:
            t.start()
        for t in threads:
            t.join()

    def finish(self, legs, code, out, rec, suite):
        """Merge one job's legs into theirs: a leg it did not run, or whose suite never reported its
        exit, fails. A job killed after it named a leg (its device lines) but before that leg's
        `M2V-SUITE` line ran nothing of it: on 248d41074f the 3090 and the UHD 630 passed that way,
        their rt jobs killed for RAM, on their harness suites alone."""
        parsed = results.parse_job(out or "")
        for leg in legs:
            leg.ended = time.time()
            if rec:
                leg.jobs.append(rec.get("id"))
            if leg.id not in parsed or not parsed[leg.id]["suites"]:
                if leg.id in parsed:
                    leg.parsed["device"].update(parsed[leg.id]["device"])
                self.fail([leg], f"{suite}: job {rec and rec.get('id')} reported no suite of leg {leg.id} "
                                 f"(exit {code}): {(out or '').strip()[-300:]}")
                continue
            leg.parsed["device"].update(parsed[leg.id]["device"])
            leg.parsed["suites"].update(parsed[leg.id]["suites"])
            if suite == "harness" and HARNESS_SUITE not in parsed[leg.id]["suites"]:
                self.fail([leg], f"harness: job {rec and rec.get('id')} reported no suite {HARNESS_SUITE} "
                                 f"of leg {leg.id} (exit {code})")

    def windows(self, leg):
        code, out, rec = self.job("winbuild", leg.node, winbuild_script(self.harness), f"winbuild-{leg.id}",
                                  space="win")
        if code != 0:
            return self.fail([leg], f"the Windows build (job {rec and rec.get('id')}) failed: exit {code}", rec)
        leg.started = time.time()
        suites = ["rt"] + (["harness"] if self.harness else [])
        while suites:
            suite = suites.pop(0)
            layer = self.layer if suite == "rt" else None
            name = f"win{suite}-{leg.id}" + ("-again" if suite == "harness" and leg.timings else "")
            code, out, rec = self.job("winrun" if suite == "rt" else "wintime", leg.node,
                                      winrun_script(leg, suite, layer and layer[1:]), name,
                                      gpus=[leg.gpu], carries=[layer[0]] if layer else [], space="win",
                                      exclusive=suite == "harness")
            self.finish([leg], code, out, rec, suite)
            if suite == "harness" and self.timed_again(leg):
                suites.append(suite)

    def lavapipe(self, leg):
        leg.node = self.build_node["node"]
        leg.started = time.time()
        layer = self.layer
        code, out, rec = self.job("lavapipe", leg.node, lavapipe_script(self.setup(leg.node), layer and layer[1:]),
                                  "lavapipe", carries=[layer[0]] if layer else [], space="lavapipe")
        self.finish([leg], code, out, rec, "lavapipe")

    def lint(self, leg):
        leg.node = self.build_node["node"]
        leg.started = time.time()
        code, out, rec = self.job("lint", leg.node, lint_script(self.setup(leg.node)), "lint", space="lint")
        self.finish([leg], code, out, rec, "lint")

    def go(self):
        """Every chain of jobs at once: the builder (its build, its GPU legs if any, lavapipe), the
        lint beside it on the builder, each other Linux GPU node (its own build where the builder's archive cannot run there,
        then its legs), and each Windows host (build, then its leg)."""
        b = self.build_node["node"]
        by_node = {}
        for leg in self.legs:
            if leg.id not in CPU_LEGS and self.nodes[leg.node]["os"] == "linux":
                by_node.setdefault(leg.node, []).append(leg)
        built = threading.Event()
        box = {}

        def from_builder():
            built.wait()
            return box.get("made", (None, "the build did not finish"))

        threads = []

        def start(legs, fn, *args):
            def chain():
                try:
                    fn(*args)
                except Exception as error:  # a chain's own failure fails its legs, not the run
                    log(f"{fn.__name__}: {error!r}")
                    self.fail(legs, f"the runner failed: {error!r}")
            t = threading.Thread(target=chain)
            t.start()
            threads.append(t)

        def builder_chain():
            try:
                box["made"] = self.linux_build(b, "build") if by_node else (None, "no GPU leg on Linux")
            finally:
                built.set()
            if b in by_node:
                self.gpu_node(b, by_node[b], from_builder)
            if lavapipe:
                self.lavapipe(lavapipe[0])

        lavapipe = [leg for leg in self.legs if leg.id == "lavapipe"]
        start(by_node.get(b, []) + lavapipe, builder_chain)
        for leg in self.legs:
            if leg.id == "lint":
                start([leg], self.lint, leg)
        cpu = self.nodes[b]["cpu_model"]
        for node, legs in sorted(by_node.items()):
            if node == b:
                continue
            if self.build_node.get("portable") or self.nodes[node]["cpu_model"] == cpu:
                start(legs, self.gpu_node, node, legs, from_builder)
            else:
                start(legs, self.gpu_node, node, legs, lambda node=node: self.linux_build(node, f"build-{node}"))
        for leg in self.legs:
            if leg.id not in CPU_LEGS and self.nodes[leg.node]["os"] == "windows":
                start([leg], self.windows, leg)
        for t in threads:
            t.join()

    def cleanup(self):
        save(STATE / "stats.json", self.stats)
        save(STATE / "workspaces.json", self.spaces)
        mirrors = Path.home() / ".local/state/potluck/mirrors"
        for name in self.carries:
            shutil.rmtree(STATE / "carry" / name, ignore_errors=True)
            for m in mirrors.glob(f"{name}-*"):
                shutil.rmtree(m) if m.is_dir() else m.unlink()


# --- commands ------------------------------------------------------------------------------------

def leg_entry(run, leg):
    """A leg's document in the note, judged against its base where only one leg is needed."""
    parsed = leg.parsed
    records, problems = results.leg_records(parsed)
    base_sha, base = base_of(run.sha, leg.id)
    problems += run.failures.get(leg.id, [])
    base_records = base and results.base_records(base["records"], harness_tree(base_sha) == harness_tree(run.sha))
    problems += results.leg_problems(parsed, records, base_records)
    problems += results.old_path_moved(parsed, run.since_bless)
    if leg.id not in CPU_LEGS and run.lock_budget:
        problems += results.lock_budget_missing(records, results.names_lock_event(run.setup(leg.node)))
    rebased = base and frozen_rebase(run.sha, results.HARNESS_SHAPE, base_sha, base)
    cpu = run.nodes.get(leg.node, {}).get("cpu_model")
    budget, budget_parked = results.harness_budget(leg.id, parsed, base and base["records"]["time"], rebased, cpu)
    problems += budget
    timed = None
    if leg.timings:
        # The old runtime's own spread in the timing judged (the last), and what came of the first.
        first = leg.timings[0]
        states = [f"VOID at {first[0]:.1%} on {first[1]}, timed again"] if len(leg.timings) > 1 else []
        if results.base_spread_void(records["time"], cpu):
            states.append("venue unstable" if len(leg.timings) > 1 else "VOID")
        timed = dict(spread=results.base_spread(records["time"], cpu), states=states)
    if not parsed["suites"] and leg.id not in run.failures:
        problems.append("no suite reported")
    dev = parsed["device"]
    layer = dev.get("validationLayer")
    if layer and layer.startswith("missing"):
        problems.append(f"validation layer {layer}")
    return dict(
        node=leg.node, cpu=cpu, gpu=leg.id if leg.id not in CPU_LEGS else None, jobs=leg.jobs,
        device=dev.get("deviceName"), driver=" ".join(v for v in (dev.get("driverName"), dev.get("driverInfo"))
                                                if v) + (f" ({dev['driverVersion']})" if dev.get("driverVersion") else "") or None,
        layer=layer,
        started=leg.started and datetime.fromtimestamp(leg.started, timezone.utc).isoformat(timespec="seconds"),
        minutes=leg.started and leg.ended and round((leg.ended - leg.started) / 60, 2),
        suites={name: {k: s[k] for k in ("exit", "run", "passed", "failed")} for name, s in parsed["suites"].items()},
        records=records, base=base_sha, base_records=base and base["records"], shape=results.HARNESS_SHAPE,
        problems=problems,
        parked=results.leg_parked(parsed, records) + budget_parked,
        **({"timed": timed} if timed is not None else {}))


def cross_gpu(sha, doc, entries):
    """The GPU legs' times and their bases' times that the cross-GPU rule compares
    (results.outlier_keys): this run's ENTRIES' and the note DOC's other GPU legs'. The median
    takes every GPU leg of the note, so a run of some legs (--legs) is judged against the GPUs it
    did not run again; only this run's legs are judged."""
    times, bases = {}, {}
    for leg_id, e in doc["legs"].items():
        if e.get("gpu") and leg_id not in entries:
            times[leg_id] = e["records"]["time"]
            bases[leg_id] = base_times(sha, *base_of(sha, leg_id))
    for leg_id, e in entries.items():
        if e["gpu"]:
            times[leg_id] = e["records"]["time"]
            bases[leg_id] = base_times(sha, e["base"], e["base_records"] and {"records": e["base_records"]})
    return times, bases


def run_cmd(sha, only, dry):
    cfg = load(CONFIG, None)
    if not cfg or not cfg.get("builders"):
        sys.exit(f"{CONFIG}: missing or without builders (see {__file__}'s header)")
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / "run.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit("another matrix run is live: runs share their workspaces, so they never overlap")
    if not (TREE / ".git").exists():
        subprocess.run([str(REPO / "scripts/lean-tree"), "worktree", str(TREE), "matrix/tree", sha], check=True)
        git("switch", "-q", "--detach", sha, cwd=TREE)
        git("branch", "-q", "-D", "matrix/tree")
    git("switch", "-q", "--detach", sha, cwd=TREE)
    if git("status", "--porcelain", cwd=TREE):
        sys.exit(f"{TREE} has changes: it must be a clean checkout of {sha}")
    nodes_json = json.loads(potluck("nodes", "--json").stdout)
    nodes = {n["facts"]["node"]: n["facts"] for n in nodes_json["nodes"] if n.get("alive")}
    legs = plan(nodes, cfg, only)
    b = builder(cfg, nodes)
    for leg in legs:
        log(f"leg {leg.id}: {leg.node or b['node']}" + (f" ({leg.icd})" if leg.icd else ""))
    log(f"builder {b['node']}{' (portable)' if b.get('portable') else ''}")
    if dry:
        return
    started = time.time()
    rdir = STATE / "runs" / f"{sha[:12]}-{time.strftime('%m%d-%H%M%S')}"
    rdir.mkdir(parents=True)
    run = Run(sha, cfg, nodes, legs, b, rdir)
    doc = note(sha) or dict(sha=sha, runs=[], legs={})
    try:
        run.go()
        entries = {leg.id: leg_entry(run, leg) for leg in legs}
        # A harness row's cross-GPU outlier in one pass fails nothing yet: once every leg is in,
        # the legs that have one are timed once more, each such row also alone in fresh processes
        # (results.alone_rows), and an outlier fails a leg only where both passes agree and its
        # lowest level is still out (results.time_outliers).
        found = results.outlier_keys(*cross_gpu(sha, doc, entries))
        first = results.outliers_to_retime({leg_id: keys for leg_id, keys in found.items() if leg_id in entries})
        if first:
            log(f"cross-GPU outliers in one pass on {', '.join(sorted(first))}: timed once more")
            again = [leg for leg in legs if leg.id in first]
            for leg in again:
                leg.alone = results.alone_rows(first[leg.id])
            run.retime(again)
            entries.update({leg.id: leg_entry(run, leg) for leg in again})
    finally:
        run.cleanup()
    outliers, parked = results.time_outliers(*cross_gpu(sha, doc, entries), first)
    for leg_id, problems in outliers.items():
        if leg_id in entries:
            entries[leg_id]["problems"] += problems
    for leg_id, lines in parked.items():
        if leg_id in entries:
            entries[leg_id]["parked"] += lines
    for leg_id, e in entries.items():
        e.pop("base_records")
        e["verdict"] = ("fail" if e["problems"] else
                        "unstable" if "venue unstable" in e.get("timed", {}).get("states", []) else "pass")
        doc["legs"][leg_id] = e
    wall = round((time.time() - started) / 60, 2)
    doc["runs"].append(dict(started=datetime.fromtimestamp(started, timezone.utc).isoformat(timespec="seconds"),
                            minutes=wall, legs=sorted(entries), build=run.build_info, jobs=sorted(run.jobs)))
    path = rdir / "note.json"
    path.write_text(json.dumps(doc, indent=1, sort_keys=True) + "\n")
    git("notes", f"--ref={NOTES}", "add", "-f", "-F", str(path), sha)
    for leg_id in sorted(entries):
        print_leg(sha, leg_id, doc["legs"][leg_id])
    print_over(sha, doc)
    failed = sum(1 for e in entries.values() if e["verdict"] == "fail")
    unstable = sum(1 for e in entries.values() if e["verdict"] == "unstable")
    print(f"matrix {sha[:12]}: {len(entries) - failed - unstable} of {len(entries)} legs pass"
          + (f", {unstable} venue unstable" if unstable else "") + f", {wall} min wall; note {NOTES}")
    print("harness rows: release build, validation layer disabled (VK_LOADER_LAYERS_DISABLE)")
    return 1 if failed else 0


def print_leg(sha, leg_id, leg):
    """SHA's leg's verdict line, then each of its harness rows' times and GPU times, with the
    frozen arm's move on its base (results.frozen_move, frozen_rebase), and the rows each of the
    frozen arm's two rules voids (results.frozen_void, results.excess_voids)."""
    print(results.verdict_line(leg_id, leg))
    base = leg.get("base") and (note(leg["base"]) or {}).get("legs", {}).get(leg_id)
    rebased = base and frozen_rebase(sha, leg.get("shape"), leg["base"], base)
    base = base and base["records"]["time"]
    for line in results.harness_rows(leg["records"], base, rebased):
        print(f"  {line}")
    if base:
        void = results.frozen_void(leg["records"]["time"], base, rebased)
        compared = {None: "every row", results.REBASED_SHAPE: "no row",
                    results.REBASED_TREES: "the creation rows alone"}[rebased]
        print(f"  frozen arm against {leg['base'][:10]}{f', {rebased}' if rebased else ''}: {compared} "
              f"compared, {len(void)} VOID, old moved past {results.FROZEN_DRIFT:.0%}"
              + "".join(f"; {row} {move:+.1%}" for row, _, _, move in void))
        excess = results.excess_voids(leg_id, leg["records"], base, rebased, leg.get("cpu"))
        print(f"  frozen arm, past its limit by less than old's own move: {len(excess)} VOID"
              + "".join(f"; {row} {ratio:.3f} over {limit:.3f}, old {move:+.1%}" for row, ratio, limit, move in excess))


def rounds_since(sha, since):
    """How many rounds ran on SHA's first-parent line from the commit SINCE on, SHA's included:
    its noted commits; None where SINCE is not on that line within 500 commits."""
    noted = {line.split()[1] for line in git("notes", f"--ref={NOTES}", "list").splitlines() if line}
    since = git("rev-parse", "--verify", "--quiet", f"{since}^{{commit}}", check=False)
    count = 0
    for commit in git("rev-list", "--first-parent", "--max-count=500", sha, check=False).splitlines():
        count += commit in noted
        if commit == since:
            return count
    return None


def print_over(sha, doc):
    """The report's one table: every row over its limit on each leg of SHA's note DOC
    (results.over_lines), with the frozen arm's verdict on its base and its status
    (results.row_status, status.tsv); then the status entries whose rows are all within their
    limits, to remove (results.entries_within)."""
    lines = []
    for leg_id, leg in sorted(doc["legs"].items()):
        if not (leg.get("records") or {}).get("time"):
            continue
        base = leg.get("base") and (note(leg["base"]) or {}).get("legs", {}).get(leg_id)
        rebased = base and frozen_rebase(sha, leg.get("shape"), leg["base"], base)
        lines += results.over_lines(leg_id, leg["records"], base and base["records"], rebased,
                                    lambda since: rounds_since(sha, since), leg.get("cpu"))
    print(f"rows over their limits: {len(lines)}")
    for line in lines:
        print(f"  {line}")
    within = results.entries_within({leg_id: (leg.get("records") or {}, leg.get("cpu"))
                                     for leg_id, leg in doc["legs"].items() if (leg.get("records") or {}).get("time")})
    print(f"status.tsv entries whose rows are within their limits, to remove: {len(within)}")
    for card, row, status, who in within:
        print(f"  {card} {row} ({status}, {who}): within its limit on every leg of its card that timed it")


def show_cmd(sha):
    doc = note(sha)
    if not doc:
        sys.exit(f"no matrix note on {sha}")
    for leg_id in sorted(doc["legs"]):
        print_leg(sha, leg_id, doc["legs"][leg_id])
    print_over(sha, doc)
    last = doc["runs"][-1]
    print(f"matrix {sha[:12]}: last run {last['started']}, {last['minutes']} min wall, jobs {' '.join(last['jobs'])}")


def main(argv):
    if not argv or argv[0] not in ("run", "show"):
        sys.exit(__doc__)
    rest = [a for a in argv[1:] if not a.startswith("--")]
    only = None
    if "--legs" in argv:
        only = argv[argv.index("--legs") + 1].split(",")
        rest.remove(argv[argv.index("--legs") + 1])
    sha = git("rev-parse", "--verify", f"{rest[0] if rest else 'development'}^{{commit}}")
    if argv[0] == "show":
        return show_cmd(sha)
    return run_cmd(sha, only, "--dry-run" in argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
