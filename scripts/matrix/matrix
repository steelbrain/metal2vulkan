def log(msg):
    print(f"{time.strftime('%H:%M:%S')} {msg}", flush=True)


def git(*args, cwd=REPO, check=True):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if check and r.returncode:
        sys.exit(f"git {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout.strip()


def potluck(*args, cwd=None):
    return subprocess.run(["potluck", *args], cwd=cwd or TREE, capture_output=True, text=True, errors="replace")


def dispatched(r):
    """`potluck dispatch --json`'s reply: the job, or the error."""
    try:
        return json.loads(r.stdout.strip().splitlines()[-1])
    except (IndexError, ValueError):
        return dict(error=(r.stderr or r.stdout).strip())


def load(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(value, indent=1, sort_keys=True) + "\n")
    tmp.replace(path)


# --- notes -------------------------------------------------------------------------------------

def note(sha):
    r = subprocess.run(["git", "notes", f"--ref={NOTES}", "show", sha], cwd=REPO, capture_output=True, text=True)
    return json.loads(r.stdout) if r.returncode == 0 else None


def base_of(sha, leg_id):
    """The nearest first-parent ancestor of SHA whose note has leg LEG_ID: (sha, that leg)."""
    noted = {line.split()[1] for line in git("notes", f"--ref={NOTES}", "list").splitlines() if line}
    for commit in git("rev-list", "--first-parent", "--max-count=500", f"{sha}~1", check=False).splitlines():
        if commit in noted:
            leg = (note(commit) or {}).get("legs", {}).get(leg_id)
            if leg:
                return commit, leg
    return None, None


def harness_tree(sha):
    """The harness crate's tree at SHA. Its times measure through the harness's own warm-up and
    windows, so two commits' times compare only when one harness measured both."""
    return git("rev-parse", f"{sha}:crates/metal2vulkan-harness", check=False)


def frozen_rebase(sha, shape, base_sha, base):
    """How the leg at SHA, timed in SHAPE, differs from its base BASE (the leg at BASE_SHA) for the
    frozen arm (results.frozen_rebased): results.REBASED_SHAPE where the base was timed in another
    shape, results.REBASED_TREES where the harness's or the old runtime's crate tree differs
    between the two commits, else None."""
    if base.get("shape") != shape:
        return results.REBASED_SHAPE
    trees = [[git("rev-parse", f"{commit}:crates/{crate}", check=False) for crate in FROZEN_CRATES]
             for commit in (sha, base_sha)]
    return None if trees[0] == trees[1] else results.REBASED_TREES


def base_times(sha, base_sha, base):
    """The times of BASE (the leg at BASE_SHA) that SHA's are judged against: none when the
    harness changed between them, and the run then sets the base for the next."""
    if not base or harness_tree(base_sha) != harness_tree(sha):
        return {}
    return (base.get("records") or {}).get("time", {})


# --- the plan ------------------------------------------------------------------------------------

class Leg:
    def __init__(self, leg_id, node, gpu=None, icd=None, select=False):
        self.id, self.node, self.gpu, self.icd, self.select = leg_id, node, gpu, icd, select
        self.jobs, self.parsed = [], dict(device={}, suites={})
        # Each harness timing's old-runtime spread (results.base_spread), in order (Run.timed_again).
        self.timings = []
        # The rows its harness's second pass re-times alone for a cross-GPU outlier (results.alone_rows).
        self.alone = []
        self.started = self.ended = None


#: The legs that need no GPU, both run on the builder.
CPU_LEGS = ("lavapipe", "lint")


def plan(nodes, cfg, only):
    """The legs: each lab GPU on one node, the nodes' loads kept even (the GPUs on fewest nodes
    placed first), each Windows GPU on its host, lavapipe and the lint. A card in the config's
    `record_nodes` runs on every node that holds it: its leg of record on the node named, an extra
    leg (results.extra_leg_id) on each other; with its node of record away, it has no leg of
    record that run."""
    skip = set(cfg.get("skip_gpus", []))
    record_nodes = cfg.get("record_nodes", {})
    linux = {n: f for n, f in nodes.items() if f["os"] == "linux"}
    where = {}
    for name, facts in sorted(linux.items()):
        for g in facts["gpus"]:
            vd = f"{g['vendor']}:{g['device']}"
            if g["vendor"] in ICDS and vd not in skip:
                where.setdefault(vd, []).append((name, g["id"]))
    load_of, legs = {n: 0 for n in linux}, []
    for vd, places in sorted(where.items(), key=lambda item: (len(item[1]), item[0])):
        icd, select = ICDS[vd.split(":")[0]]
        taken = {(leg.node, leg.icd) for leg in legs if not leg.select}
        places = [p for p in places if select or (p[0], icd) not in taken]
        if not places:
            log(f"{vd}: every node holding it already runs a leg on its driver, which cannot pick between two")
            continue
        recorded = record_nodes.get(vd)
        if recorded is not None:
            if recorded not in {node for node, _ in places}:
                log(f"{vd}: its node of record {recorded} is not among its nodes, so it has no leg of record")
            for node, gpu in places:
                load_of[node] += 1
                leg_id = vd if node == recorded else results.extra_leg_id(vd, node)
                legs.append(Leg(leg_id, node, gpu, icd, select))
            continue
        node, gpu = min(places, key=lambda p: (load_of[p[0]], p[0]))
        load_of[node] += 1
        legs.append(Leg(vd, node, gpu, icd, select))
    for name, facts in sorted(nodes.items()):
        if facts["os"] == "windows":
            legs += [Leg(f"{g['vendor']}:{g['device']}", name, g["id"]) for g in facts["gpus"]
                     if f"{g['vendor']}:{g['device']}" not in skip]
    legs += [Leg(leg_id, None) for leg_id in CPU_LEGS]
    if only:
        unknown = set(only) - {leg.id for leg in legs}
        if unknown:
            sys.exit(f"no such leg: {', '.join(sorted(unknown))}")
        legs = [leg for leg in legs if leg.id in only]
    return legs


def builder(cfg, nodes):
    for b in cfg["builders"]:
        if b["node"] in nodes and (not b.get("gate") or subprocess.run(b["gate"], shell=True).returncode == 0):
            return b
    sys.exit("no builder is up with its gate open")


# --- job scripts ---------------------------------------------------------------------------------

def layer_lines(layer, os_name, leg):
    """Shell that unpacks the carried validation layer's OS_NAME directory in the job's workspace,
    points the loader at it and prints its version as a device fact of LEG (`validationLayer`).
    Where there is none, it says so there and points the loader at a directory with no layer, so
    the device tests, which check that a validation tool is active, fail rather than run under
    another version the node has."""
    none = (f'export VK_LAYER_PATH="$PWD/.no-validation-layer"; '
            f'echo "M2V-DEVICE {leg} validationLayer missing: ')
    if not layer:
        return none + 'the matrix has no layer carry (scripts/validation-layer)"'
    mirror, rev = layer
    point = ('export VK_LAYER_PATH="$(cygpath -w "$L")" PATH="$L:$PATH"' if os_name == "windows"
             else 'export VK_LAYER_PATH="$L"')
    return (f'L="$PWD/.validation-layer"; rm -rf "$L"; mkdir -p "$L" && '
            f'git --git-dir="${mirror}" archive "{rev}" {os_name} | tar -x -C "$L" && L="$L/{os_name}" && '
            f'test -f "$L/VERSION" && {point} && echo "M2V-DEVICE {leg} validationLayer $(head -1 "$L/VERSION")" || '
            f'{{ {none}the carry\'s {os_name} directory did not unpack"; }}')


def linux_head(short, setup):
    """Every Linux job: the per-commit source path the GPU legs' archive is built and run at (the
    archive holds the build's paths, so every node lays the tree out at the same one), with the
    Metal observations alone (the stream device tests read the public cases' Metal outputs from
    them) and none of the other backends', which nothing it runs reads."""
    return f"""set -u
M="$HOME/.cache/metal2vulkan-matrix"; S="$M/src-{short}"; mkdir -p "$M"
find "$M" -maxdepth 1 -name 'src-*' ! -name 'src-{short}' -mmin +720 -exec rm -rf {{}} +
{setup}
lay_out() {{
  flock "$M/.lock" sh -c 'test -d "$1" || {{ t="$1.tmp.$$" && rm -rf "$t" && mkdir -p "$t" && git archive HEAD -- . ":(exclude)crates/metal2vulkan-validation/corpus/observations" | tar -x -C "$t" && git archive HEAD -- {METAL_OBSERVATIONS} | tar -x -C "$t" && mv "$t" "$1"; }}' sh "$S"
}}
"""


def build_script(short, setup, harness):
    """The GPU legs' files: the device tests' nextest archive, built at the per-commit path, and,
    where the commit has the harness, its release command, built in the workspace (it finds the
    tree through `CARGO_MANIFEST_DIR` where it runs)."""
    timed = (f"""
cargo build --release -p metal2vulkan-harness --bin harness && cp -f target/release/harness {HARNESS}
h=$?""" if harness else "\nh=0")
    return linux_head(short, setup) + f"""W=$PWD
lay_out || exit 3
cd "$S" && RUSTFLAGS='--cfg m2v_gpu' CARGO_TARGET_DIR="$S/target/gpucfg" cargo nextest archive {" ".join(f"-p {p}" for p in DEVICE_TEST_PACKAGES)} --all-features --archive-file "$W/{ARCHIVE}"
a=$?
cd "$W" && rm -rf "$S"{timed}
echo "M2V-BUILD exit $a $h"
[ $a -eq 0 ] && [ $h -eq 0 ]
"""


def gpu_script(short, setup, legs, mirror, rev, suite, last, layer=None, cpu=None):
    """A node's legs in turn, running SUITE: `rt` (the device tests, under the validation layer
    LAYER carries, layer_lines) or `harness` (the timed workloads, both runtimes in one process,
    harness_runs, on a node whose CPU model is CPU, without it). The node's LAST job removes the tree and its carry's mirror there
    (no other job reads it; potluck never prunes one), and any left by a job that never ran."""
    runs = "\n".join(" ".join(["leg", leg.id, leg.icd, shlex.quote(results.card_of(leg.id) + "!" if leg.select else ""),
                               shlex.quote(" ".join(leg.alone))])
                     for leg in legs)
    if suite == "rt":
        file, body = ARCHIVE, f"""{layer_lines(layer, 'linux', '$1')}
    cargo nextest run --archive-file "$F" --workspace-remap "$S" -E '{DEVICE_TEST_FILTER}' {NEXTEST_OUT} 2>&1 | awk "$KEEP"
    exit ${{PIPESTATUS[0]}}"""
    else:
        file, body = HARNESS, harness_runs('"$S/crates/metal2vulkan-harness"', '"$F"', '$1', cpu=cpu)
    tidy = """rm -rf "$S"
m="${mirror}"; rm -rf "$m" "${{m%.git}}.lock" "${{m%.git}}.worktrees.lock"
find "$POTLUCK_HOME/mirrors" -maxdepth 1 -name 'm2v-matrix-*' -mmin +720 -exec rm -rf {{}} +""".format(mirror=mirror) if last else ""
    return linux_head(short, setup) + f"""lay_out || exit 3
F="$PWD/{file}"
git --git-dir="${mirror}" cat-file blob "{rev}:{file}" > "$F" && chmod +x "$F" || exit 3
KEEP='{KEEP}'
all=0
leg() {{
  echo "M2V-LEG $1 begin"
  (
    export VK_DRIVER_FILES="/usr/share/vulkan/icd.d/$2_icd.json"
    if [ -n "$3" ]; then export MESA_VK_DEVICE_SELECT="$3"; fi
    export M2V_ALONE="$4"
    {DEVICE_LINES.format(leg="$1")}
    {body}
  )
  rc=$?
  {'echo "M2V-SUITE $1 rt exit $rc"' if suite == "rt" else ""}
  [ $rc -eq 0 ] || all=1
}}
{runs}
rm -f "$F"
{tidy}
exit $all
"""


def harness_runs(manifest_dir, command, leg, windows=False, cpu=None):
    """The harness command on leg LEG, its one suite (HARNESS_SUITE); the shell's status is 1
    where it failed. The two runtimes' rows are timed in one process, `--runtime` naming
    HARNESS_RUNTIMES in order: each workload runs on each runtime in turn, so the runtimes'
    passes alternate on the GPU, the node and the driver as they are at that moment, and a clock
    or a co-runner that moves one moves the other alike. The process has a fresh empty driver
    shader cache (Mesa's MESA_SHADER_CACHE_DIR, NVIDIA's __GL_SHADER_DISK_CACHE_PATH; on WINDOWS,
    the Intel driver's, which follows LOCALAPPDATA and USERPROFILE), so its first uses compile
    cold whatever ran on the node before; the new runtime runs first in each workload, so its
    first uses, the judged ones, compile before the old runtime's of the same workload, as cold
    as in a process of its own. For HARNESS_WARM, a short second run on the same cache follows,
    before the suite's line, and its first-use records are kept under harness-<runtime>-warm/: the
    same first uses with the driver's cache warm. These runs skip the creation rows
    (results.HARNESS_CREATES): those run alone after them, in results.FIRST_RUNS rounds, each
    round one process per runtime, the runtimes' order alternating from round to round, each
    process on a fresh empty driver cache and store. So a creation's first sample is cold against
    cold: no row before it, and no work of the other runtime in its process, warms the driver
    for it (a driver's process-wide setup, paid by whichever runtime makes the process's first
    pipeline, took one runtime's first state from 16.7 ms cold to 5.3 ms behind the other's on an
    Iris Xe). The first round's two outputs are kept whole, their devices' records (totals and
    gauges at drop) apart (results.CREATES_APART); of each later process's, only the first samples
    (results.FIRST_KEEP), which results.harness_budget judges by the median of the rounds. Then the rows over their limits (results.RETIME_SELECT, at most
    results.RETIME_ROWS, the furthest over first) are each re-timed alone in results.RETIME_PAIRS
    pairs, old then new, then new then old, their times and GPU times kept (results.RETIME_KEEP)
    for results.harness_budget, but for those a node whose CPU model is CPU judges by their counts
    (results.retime_skip); a frames workload's latency from idle row (results.FROM_IDLE)
    by its workload's runs. In a cross-GPU outlier's second pass, the rows M2V_ALONE names
    (results.alone_rows) are each run alone in results.RETIME_PAIRS pairs the same way, every
    process on a fresh empty driver cache and store, their times kept (results.ALONE_KEEP) for
    results.time_outliers, which judges such a row by its lowest level. A row whose size follows the device is sized by the first
    runtime's pass, which the process gives the other, and every later run, warm and re-timed ones
    included, is given that size (`--size`), so each runtime times the same work. The process has
    a fresh empty store for its pipelines (`--store`, each runtime's apart in it), so its first
    uses and its `create_state` row are cold for both runtimes; the warm run takes the same store,
    warm; a re-timed row's runs each take a fresh store of the harness's own. The loader's
    VK_LOADER_LAYERS_DISABLE (loader 1.3.234 and later) names the validation layer, and that layer
    alone, since Mesa's device-select layer picks the card: whatever the node has installed, every
    harness row is a release build without the layer."""
    runtimes = ",".join(HARNESS_RUNTIMES)
    profile = unprofile = ""
    store = '"$(cygpath -w "$store")"' if windows else '"$store"'
    point = ""
    if windows:
        point = r"""      mkdir -p "$cache/AppData/Local" && w=$(cygpath -w "$cache") || exit 3
      export LOCALAPPDATA="$w\AppData\Local" USERPROFILE="$w"
"""
        profile = "    saved_local=$LOCALAPPDATA saved_profile=$USERPROFILE\n" + point
        unprofile = '\n    export LOCALAPPDATA="$saved_local" USERPROFILE="$saved_profile"'
    creates = f"'{results.HARNESS_CREATES}*'"
    rename = r"s#^M2V-MATRIX \([a-z]*\) harness-$runtime/\([a-z]*\)/first_use_#M2V-MATRIX \1 harness-$runtime-warm/\2/first_use_#p"
    limits = "\n".join(f"      {leg_id}|{leg_id}@*) limits='{results.harness_limits(leg_id)}' "
                        f"gpulimits='{results.harness_limits(leg_id, gpu=True)}' ;;"
                        for leg_id in sorted(set(results.HARNESS_CEILINGS) | set(results.HARNESS_FLOORS)
                                             | set(results.HARNESS_GPU_FLOORS)))
    sized = r"s#^\([a-z0-9_]*\)  *[a-z]*  *sized to \([0-9][0-9]*\) .*#--size \1=\2#p"
    return f"""out=$(mktemp -d) || exit 3
    cache=$(mktemp -d) && store=$(mktemp -d) || exit 3
    export MESA_SHADER_CACHE_DIR="$cache" __GL_SHADER_DISK_CACHE_PATH="$cache"
    export VK_LOADER_LAYERS_DISABLE=VK_LAYER_KHRONOS_validation
{profile}    CARGO_MANIFEST_DIR={manifest_dir} {command} --runtime {runtimes} --skip {creates} --store {store} 2>&1 | tee "$out/timed"
    r=${{PIPESTATUS[0]}}
    sizes=$(sed -n "{sized}" "$out/timed" | sort -u | tr '\\n' ' ')
    for runtime in {" ".join(HARNESS_WARM)}; do
      CARGO_MANIFEST_DIR={manifest_dir} {command} --runtime $runtime $sizes --skip {creates} --store {store} --runs 5 --warmup 1 --no-settle 2>&1 |
        sed -n "{rename}"
    done
    for n in $(seq {results.FIRST_RUNS}); do
      case $((n % 2)) in 1) order="{" ".join(HARNESS_RUNTIMES)}" ;; *) order="{" ".join(reversed(HARNESS_RUNTIMES))}" ;; esac
      for runtime in $order; do
        rm -rf "$cache" "$store"
        cache=$(mktemp -d) && store=$(mktemp -d) || exit 3
        export MESA_SHADER_CACHE_DIR="$cache" __GL_SHADER_DISK_CACHE_PATH="$cache"
{point}        if [ $n -eq 1 ]; then
          CARGO_MANIFEST_DIR={manifest_dir} {command} --runtime $runtime --only {creates} --store {store} 2>&1 |
            sed "{results.CREATES_APART}" | tee -a "$out/timed"
        else
          CARGO_MANIFEST_DIR={manifest_dir} {command} --runtime $runtime --only {creates} --store {store} 2>&1 |
            sed -n "{results.FIRST_KEEP}"
        fi
        [ ${{PIPESTATUS[0]}} -eq 0 ] || r=1
      done
    done
    case "{leg}" in
{limits}
      *) limits= gpulimits= ;;
    esac
    select='{results.RETIME_SELECT}'
    rows=$(awk -v limits="$limits" -v gpulimits="$gpulimits" -v wallre='{results.WALL_RE}' -v skipre='{results.retime_skip(cpu)}' -v budget={results.HARNESS_BUDGET!r} "$select" "$out/timed" | sort -rn | head -n {results.RETIME_ROWS} | cut -d' ' -f2)
    for row in $rows; do
      for pair in $(seq {results.RETIME_PAIRS}); do
        case $pair in 2) order="new old" ;; *) order="old new" ;; esac
        for timed in $order; do
          CARGO_MANIFEST_DIR={manifest_dir} {command} --runtime $timed $sizes --only "${{row%{results.FROM_IDLE}}}" 2>&1 | sed -n "{results.RETIME_KEEP}"
        done
      done
    done
    for row in ${{M2V_ALONE:-}}; do
      workload=${{row%%/*}}
      for pair in $(seq {results.RETIME_PAIRS}); do
        case $pair in 2) order="new old" ;; *) order="old new" ;; esac
        for timed in $order; do
          rm -rf "$cache" "$store"
          cache=$(mktemp -d) && store=$(mktemp -d) || exit 3
          export MESA_SHADER_CACHE_DIR="$cache" __GL_SHADER_DISK_CACHE_PATH="$cache"
{point}          CARGO_MANIFEST_DIR={manifest_dir} {command} --runtime $timed $sizes --only "${{workload%{results.FROM_IDLE}}}" --store {store} 2>&1 | sed -n "{results.ALONE_KEEP}"
        done
      done
    done
    unset MESA_SHADER_CACHE_DIR __GL_SHADER_DISK_CACHE_PATH{unprofile}
    rm -rf "$cache" "$store" "$out"
    echo "M2V-SUITE {leg} {HARNESS_SUITE} exit $r"
    exit $r"""


def lavapipe_script(setup, layer=None):
    """The gate's suites and the CPU-ICD device tests in one build: `m2v_cpu_icd` adds the device
    tests to every test the plain build has; rt's run under the validation layer LAYER carries."""
    return f"""set -u
{setup}
export RUSTFLAGS='--cfg m2v_cpu_icd' RUSTDOCFLAGS='--cfg m2v_cpu_icd' CARGO_TARGET_DIR=target/cpuicd
export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/lvp_icd.json LP_NUM_THREADS=1
KEEP='{KEEP}'
echo "M2V-LEG lavapipe begin"
{DEVICE_LINES.format(leg="lavapipe")}
{layer_lines(layer, 'linux', 'lavapipe')}
cargo nextest run --workspace --all-features {NEXTEST_OUT} 2>&1 | awk "$KEEP"
a=${{PIPESTATUS[0]}}
echo "M2V-SUITE lavapipe workspace exit $a"
cargo test --workspace --all-features --doc 2>&1 | grep -E '^(test result:|error)|FAILED|panicked'
d=${{PIPESTATUS[0]}}
echo "M2V-SUITE lavapipe doctests exit $d"
[ $a -eq 0 ] && [ $d -eq 0 ]
"""


def lint_script(setup):
    """The gate's format check, clippy in each configuration and Rustdoc, each its own suite, in a
    tree of its own so they run beside the builder's other jobs."""
    show = "awk 'n < 40 && /^(error|warning)|^ *--> / { print; n++ }'"
    return f"""set -u
{setup}
echo "M2V-LEG lint begin"
all=0
step() {{
  name=$1; shift
  "$@" 2>&1 | {show}
  rc=${{PIPESTATUS[0]}}
  echo "M2V-SUITE lint $name exit $rc"
  [ $rc -eq 0 ] || all=1
}}
step fmt cargo fmt --all --check
step clippy cargo clippy --workspace --all-targets --all-features -- -D warnings
step clippy-gpu env RUSTFLAGS='--cfg m2v_gpu' CARGO_TARGET_DIR=target/gpucfg cargo clippy --workspace --all-targets --all-features -- -D warnings
step clippy-cpu-icd env RUSTFLAGS='--cfg m2v_cpu_icd' CARGO_TARGET_DIR=target/cpuicd cargo clippy --workspace --all-targets --all-features -- -D warnings
step rustdoc env RUSTDOCFLAGS='-D warnings' cargo doc --workspace --all-features --no-deps
exit $all
"""


def windows_head():
    """Windows jobs build and run under MSYS2 CLANG64 with the pinned nightly's gnullvm host
    toolchain; `scripts/rustc-wrapper` is a shell script, which cargo cannot run there."""
    return """set -u
export PATH="/c/msys64/clang64/bin:$PATH" RUSTC_WRAPPER=
export RUSTUP_TOOLCHAIN="$(sed -n 's/^channel = "\\(.*\\)"$/\\1/p' rust-toolchain.toml)-x86_64-pc-windows-gnullvm"
export RUSTFLAGS='--cfg m2v_gpu' CARGO_TARGET_DIR=target/gpucfg
"""


def winbuild_script(harness):
